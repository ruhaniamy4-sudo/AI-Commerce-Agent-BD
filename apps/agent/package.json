{
    "name": "edutechs-ai",
    "version": "1.0.0",
    "main": "index.js",
    "license": "MIT",
    "scripts": {
        "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 ts-node-dev --respawn --transpile-only src/server.ts",
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --exclude dist/**",
        "start": "node dist/src/server.js",
        "worker": "ts-node src/worker.ts",
        "test-calendar": "ts-node src/test-calendar.ts",
        "test-calendar-v2": "ts-node src/test-calendar-v2.ts",
        "train-rag": "ts-node src/scripts/train-rag.ts",
        "migrate:tenancy": "ts-node src/scripts/migrate-tenancy.ts",
        "migrate:text-indexes": "ts-node src/scripts/migrate-text-indexes.ts"
    },
    "dependencies": {
        "@edutechs/shared": "*",
        "@googleapis/calendar": "^14.2.0",
        "@langchain/community": "^1.1.1",
        "@langchain/core": "^1.1.8",
        "@langchain/langgraph": "^1.0.7",
        "@langchain/openai": "^1.2.0",
        "@types/express": "^5.0.6",
        "@types/morgan": "^1.9.10",
        "@types/nodemailer": "^7.0.4",
        "axios": "^1.13.2",
        "bullmq": "^5.66.5",
        "cloudinary": "^2.8.0",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^5.2.1",
        "googleapis": "^169.0.0",
        "ioredis": "^5.9.2",
        "langchain": "^1.2.3",
        "mongoose": "^9.1.0",
        "morgan": "^1.10.1",
        "node-cache": "^5.1.2",
        "nodemailer": "^7.0.12",
        "openai": "^6.15.0",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.9.3",
        "uuid": "^13.0.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/node-cache": "^4.1.3",
        "@types/supertest": "^6.0.3",
        "@types/uuid": "^10.0.0",
        "cross-env": "^10.1.0",
        "supertest": "^7.2.2",
        "ts-node": "^10.9.2",
        "vitest": "^4.0.17"
    }
}
