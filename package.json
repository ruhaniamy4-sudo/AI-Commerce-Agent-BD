{
  "name": "edutechs-ai-platform",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:full": "node scripts/dev.mjs --full",
    "dev:core": "node scripts/dev.mjs agent dashboard",
    "dev:agent": "npm run dev -w apps/agent",
    "dev:dashboard": "npm run dev -w apps/dashboard",
    "dev:storefront": "npm run dev -w apps/storefront",
    "start": "npm run start -w apps/agent",
    "worker": "npm run worker -w apps/agent",
    "build": "npm run build -w packages/shared && npm run build -w apps/agent && npm run build -w apps/dashboard && npm run build -w apps/storefront",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "smoke:baseline": "node scripts/smoke-baseline.mjs",
    "migrate:tenancy": "npm run migrate:tenancy -w apps/agent",
    "migrate": "npm run migrate:tenancy",
    "migrate:text-indexes": "npm run migrate:text-indexes -w apps/agent",
    "migrate:training-indexes": "npm run migrate:training-indexes -w apps/agent",
    "migrate:intelligence": "npm run migrate:intelligence -w apps/agent",
    "migrate:subscriptions": "npm run migrate:subscriptions -w apps/agent --",
    "health:check": "node scripts/health-check.mjs",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f mongo redis"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.3"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "mongodb-memory-server@11.2.0": true,
    "unrs-resolver@1.12.2": true,
    "msgpackr-extract@3.0.4": true,
    "core-js@3.50.0": true
  },
  "overrides": {
    "next": "16.1.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "three": "0.186.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10"
  }
}
