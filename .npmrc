# One install for the whole workspace.
#
# @langchain/community declares a peer on @browserbasehq/stagehand, which in turn
# peers dotenv@^16 while the agent needs dotenv@17. npm refuses the tree over that
# alone, even though stagehand is never installed. Without this flag npm falls back
# to a fully nested tree per workspace — which is how apps/agent ended up with its
# own copy of 123 packages. Keeping it here means a developer, CI and Render all
# resolve the same way.
legacy-peer-deps=true
