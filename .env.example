# SellPilot — one environment file for the whole workspace.
#
# Sections below are marked with `# @app <names>`: those lines reach only the
# apps named, so the public storefront never holds the agent's secrets. Lines
# above the first marker reach every app. The same name may appear in more than
# one section with a different value.
#
# Anything set in the real environment (Render, Vercel, CI) always wins over
# this file. Loaded by scripts/load-env.cjs.

# @app agent, dashboard
# ── Shared by agent, dashboard ────────────────────────────────────────────
OAUTH_INTERNAL_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# @app agent
# ── Agent — apps/agent ────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/sellpilot?retryWrites=true&w=majority
REDIS_URL=
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
AUTH_JWT_SECRET=
AUTH_REQUIRE_VERIFIED_EMAIL=true
TRUST_PROXY=
COURIER_CREDENTIALS_ENCRYPTION_KEY=
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-5.2
OPENAI_VISION_MODEL=gpt-4o-mini
# Turns replayed to the model each call, and the character ceiling they share.
# The per-message cap is what lets the same ceiling carry eight turns instead of
# two: one long catalog listing used to fill the whole window on its own.
AI_RECENT_MESSAGE_LIMIT=12
AI_HISTORY_CHAR_BUDGET=1800
AI_HISTORY_MESSAGE_CHAR_CAP=400
# The rolling transcript summary costs no LLM call, so it should start as soon as
# messages fall out of that window. At 20, with a window of 12, it did not run
# until a conversation passed 32 messages and everything older was simply lost.
AI_SUMMARY_THRESHOLD=6
RAG_TOP_K=3
INGESTION_MAX_PAGES=12
INGESTION_FETCH_TIMEOUT_MS=10000
INGESTION_MAX_RESPONSE_BYTES=2000000
INGESTION_MAX_FILE_BYTES=10000000
AI_MAX_OUTPUT_TOKENS=500
AI_MODEL_PRICING_JSON={}
AI_SUBSCRIPTION_ENFORCEMENT=false
IMAGE_CONTEXT_TTL_MINUTES=10
DEFAULT_BUSINESS_NAME=Default Business
DEFAULT_BUSINESS_SLUG=default-business
DEFAULT_WEB_CHANNEL_ID=storefront
BOOTSTRAP_OWNER_NAME=Business Owner
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_PASSWORD=
BUSINESS_ID=
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
OPENAI_API_KEY=
HF_API_KEY=
FB_VERIFY_TOKEN=
FB_APP_ID=
FB_APP_SECRET=
FB_GRAPH_API_VERSION=v26.0
FB_OAUTH_REDIRECT_URI=http://localhost:4000/facebook/oauth/callback
FB_CONFIG_ID=
# WhatsApp runs on the same Meta app as Messenger. Only the Embedded Signup
# configuration id is WhatsApp-only: set it and merchants connect WhatsApp in a
# single click instead of pasting a phone number ID and a permanent token. The
# three below each fall back to their FB_ equivalent when left empty.
WHATSAPP_CONFIG_ID=
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
FACEBOOK_CREDENTIALS_ENCRYPTION_KEY=
PUBLIC_AGENT_URL=http://localhost:4000
DASHBOARD_URL=http://localhost:3000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/google/callback
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_SERVICE=gmail
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false

# @app dashboard
# ── Dashboard — apps/dashboard ────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_STOREFRONT_URL=https://aicommerceagent.vercel.app
AGENT_API_BASE_URL=http://localhost:4000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CONFIG_ID=

# @app storefront
# ── Storefront — apps/storefront ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_BUSINESS_CHANNEL_ID=storefront
